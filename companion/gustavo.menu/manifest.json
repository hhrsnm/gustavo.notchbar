{
  "schemaVersion": 1,
  "id": "gustavo.menu",
  "name": "Notch Island Menu",
  "version": "1.0.0",
  "author": "Gustavo",
  "description": "Dynamic island launcher for Omarchy shell",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "menu": "Menu.qml",
    "barWidget": "BarWidget.qml"
  },
  "omarchy": {
    "clonedFrom": "omarchy.menu"
  },
  "barWidget": {
    "displayName": "Omarchy menu",
    "description": "Launches the Notch Island menu",
    "category": "Compositor",
    "allowMultiple": false
  }
}
